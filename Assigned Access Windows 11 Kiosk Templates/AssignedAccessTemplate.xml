    <Configs>
        <Config>
            <AutoLogonAccount rs5:DisplayName="Malinoski Kiosk Browser" />
            <DefaultProfile Id="{EDB3036B-780D-487D-A375-69369D8A8F78}" />
        </Config>
        <Config>
            <UserGroup Type="LocalGroup" Name="Users" />
            <DefaultProfile Id="{377435b7-eee7-4e17-80f8-3b8c7b929d13}"/>
        </Config>
    </Configs>
